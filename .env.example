# Porter Verify — example environment configuration.
# Copy to `.env` for local development and fill in real values.
# NEVER commit a real `.env`. Production secrets come from a secrets manager
# (Vault / cloud Secrets Manager) — the app only ever sees references, not plaintext.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# One of: local | staging | production
PORTER_ENV=local

# Logging: DEBUG | INFO | WARNING | ERROR
PORTER_LOG_LEVEL=INFO
# Render logs as human-friendly console output (true) or JSON lines (false).
# Use false in staging/production so logs are machine-parseable.
PORTER_LOG_CONSOLE=true
PORTER_SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Real target is PostgreSQL (see docker-compose.yml). Example local Postgres URL:
#   postgresql+psycopg://porter:porter@localhost:5432/porter_verify
# The test suite defaults to an isolated SQLite DB and does NOT need this set.
PORTER_DATABASE_URL=postgresql+psycopg://porter:porter@localhost:5432/porter_verify

# ---------------------------------------------------------------------------
# Evidence store (object storage in prod; local directory in dev)
# ---------------------------------------------------------------------------
PORTER_EVIDENCE_DIR=./evidence_store

# ---------------------------------------------------------------------------
# API Authentication (required — no requests are accepted without this)
# ---------------------------------------------------------------------------
# Comma-separated triples: email:role:key
# Roles: sales | underwriter | ops | admin | compliance
# Generate a key: python -c "import secrets; print('sk-v1-' + secrets.token_urlsafe(24))"
PORTER_API_KEYS=alice@portercap.net:sales:sk-v1-s-REPLACE_ME,bob@portercap.net:admin:sk-v1-a-REPLACE_ME

# ---------------------------------------------------------------------------
# CORS (staging / production only — leave blank for local dev)
# ---------------------------------------------------------------------------
# Comma-separated frontend origins for the browser.
# Example: https://verify.portercap.net,https://verify-staging.portercap.net
PORTER_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Vendor / data-source credentials — references only.
# In production these are secret-manager refs, NOT plaintext keys.
# Leave blank locally to use the built-in mock connector.
# ---------------------------------------------------------------------------
PORTER_SOS_VENDOR_API_KEY=

# Salesforce (Phase 3 — leave blank until integration is approved & configured)
PORTER_SALESFORCE_CLIENT_ID=
PORTER_SALESFORCE_CLIENT_SECRET=
PORTER_SALESFORCE_INSTANCE_URL=

# Error monitoring (optional)
PORTER_SENTRY_DSN=
